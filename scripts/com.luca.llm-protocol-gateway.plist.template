<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.luca.llm-protocol-gateway</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__ROOT__/scripts/run-gateway-service.sh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__ROOT__</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>GATEWAY_ADDR</key>
    <string>0.0.0.0:18093</string>
    <key>PATH</key>
    <string>__HOME__/.bun/bin:__HOME__/.local/bin:__HOME__/.opencode/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <!-- 不能用裸 KeepAlive=true：它表示「进程退出就重拉」，不看退出原因。
       启动脚本一旦被删（源码目录挪走 / 清理过），launchd 就会每 10 秒重拉
       一个必然失败的任务，stderr 无声地涨 —— 实测一台机器上 51MB，全是
       「run-gateway-service.sh: No such file or directory」，而且这个循环
       还一直占着 18093，桌面 App 想自己托管同一端口时永远起不来。
       加上 SuccessfulExit=false 后，脚本非零退出（含 exec 找不到文件）时
       launchd 仍然按 KeepAlive 重试，但配合 ThrottleInterval 把间隔拉开；
       真正兜底的是桌面 App 与 install 脚本会删掉指向已消失脚本的 plist。 -->
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ThrottleInterval</key>
  <integer>30</integer>
  <key>StandardOutPath</key>
  <string>__ROOT__/.cache/gateway-launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>__ROOT__/.cache/gateway-launchd.err.log</string>
  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
